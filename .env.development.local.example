NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Base URL usada no servidor para links de e-mail e redirects
APP_BASE_URL=http://localhost:3000

CRON_SECRET=YOUR_CRON_SECRET
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev
SCHEDULE_EMAIL_TEST_RECIPIENT=you@example.com

# YouTube Data API v3 — busca de vídeos ao cadastrar músicas
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Importador CifraClub com navegador real (obrigatorio para importar links do CifraClub)
CIFRACLUB_IMPORTER_URL=http://localhost:3010
CIFRACLUB_IMPORTER_TOKEN=wf_cifraclub_a8f6c2e9d14b47f39c05e72ab6d8f341

# Google Calendar (OAuth2) — eventos reais com lembretes nativos (ver docs de setup no Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
